# ============================================================================
# 予时妍 YUÉ ATELIER · 生产环境变量模板
#
# 用法（首次部署）：
#     cd /opt/mua/deploy
#     cp env.example .env
#     sudo nano .env          # 填上真实密码与密钥
#
# ⚠️ .env 已被仓库根 .gitignore 排除，**永远不要提交**。
#    .env 是本文件（env.example）的唯一消费者，缺项会在 compose 启动时报错，
#    所以新增配置项请**两边同步**（代码 + 本文件 + deploy/docker-compose.yml）。
#
# 本地开发请用 server/.env.mua（DB 走 ssh 隧道 127.0.0.1:33061），
# 那份和生产这份是**两套独立配置**，别混用。
# ============================================================================

# --------------------------------------------------------------- 数据库
# ⚠️ DB_HOST 必须是**容器名** sanhe-mysql，不是 127.0.0.1：
#    mua-api 容器加入 sanhe_default 网络后，MySQL 容器在网络内以容器名可达。
#    sanhe-mysql 没有映射到宿主机 3306（见 sanhe 的 compose），
#    写 127.0.0.1 会得到 "ECONNREFUSED 127.0.0.1:3306"，且报错信息极具误导性
#    （看起来像"数据库没启动"，实际是连错了地址）。
DB_HOST=sanhe-mysql
DB_PORT=3306
DB_USER=mua
# TODO 填写真实密码（与 sanhe-mysql 容器内 mua 账号一致）
DB_PASSWORD=
DB_NAME=mua_portfolio

# ------------------------------------------------------- 管理后台鉴权
# 登录接口签发 JWT 用的密钥，HS256 建议 ≥ 32 字符随机串。
# 留空会导致容器每次重启签出不同密钥 → 后台登录态随机失效。
ADMIN_JWT_SECRET=

# ------------------------------------------------------------- 站点
# 首个管理员账号仅在 admin_account 表为空时创建（见 server/src/admin.ts 的
# ensureAdminAccount）。改密请走后台接口，不要改这里。
ADMIN_USERNAME=mua
ADMIN_PASSWORD=

# --------------------------------------------------------- 对外端口
# 宿主对外暴露的端口。80 被同机 sanhe-web 占用，本项目另开端口。
# 域名 + 腾讯云免费 DV 证书到位后，改这里并在 Nginx 加 listen 443 即可。
HTTP_PORT=8083
